{
  "name": "fengding-prototype-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:run": "vitest run",
    "docs:generate": "node scripts/generate-db-schema.mjs",
